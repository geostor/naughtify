{
  "name": "naughtify",
  "version": "0.3.0",
  "description": "Make your shipped JavaScript look too alarming for LLM scrapers to read. CLI, Bun plugin and Node API.",
  "type": "module",
  "bin": {
    "naughtify": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    },
    "./decoys": {
      "types": "./dist/decoys.d.ts",
      "default": "./dist/decoys.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "geostor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geostor/naughtify.git"
  },
  "homepage": "https://github.com/geostor/naughtify#readme",
  "bugs": "https://github.com/geostor/naughtify/issues",
  "keywords": [
    "anti-scraping",
    "ai-scraper",
    "llm",
    "anti-ai",
    "bot-protection",
    "obfuscation",
    "prompt-injection",
    "honeypot",
    "canary",
    "web-scraping",
    "bun",
    "bun-plugin",
    "vite",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "example": "bun example/build.ts",
    "test": "node test/core.test.ts"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "javascript-obfuscator": "^5.9.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
